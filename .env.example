# Multi-Agent Transparency Platform Configuration
DATABASE_PATH=data/generated/transparency_events.db
DEFAULT_CAPTURE_LEVEL=2
REDACT_PII=true

# LLM API Configuration (OpenAI, Groq, OpenRouter, DeepSeek, or Hugging Face)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Hugging Face Router
# HF_TOKEN=your_huggingface_router_api_key_here

# Server Ports
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Dataset URLs & Configuration
CFPB_COMPLAINTS_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip
KAGGLE_CFPB_DATASET=selener/consumer-complaint-database
MAX_DATASET_RECORDS=10000
